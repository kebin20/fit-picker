{
  "name": "fit-picker",
  "private": true,
  "version": "0.13.1",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:browser": "node scripts/check-app.mjs",
    "deploy": "npm run build && wrangler deploy",
    "models:build": "node scripts/build-garment-models.mjs",
    "models:check": "node scripts/build-garment-models.mjs --verify-only",
    "test:garments": "node scripts/check-garment-models.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.181.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.181.0",
    "@vitejs/plugin-react": "^5.0.0",
    "esbuild": "0.28.2",
    "sharp": "^0.35.5",
    "typescript": "~5.9.3",
    "vite": "^7.2.0",
    "vitest": "^5.1.0",
    "wrangler": "^4.45.0"
  }
}
